# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist
/dist-ssr

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo

# database
*.sqlite3
*.db
*.db-journal
pos.db

# Editor directories and files
.vscode/*
